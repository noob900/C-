<?xml version="1.0" ?>
<robot name="quadbot">
  
  <!-- ===== BASE BODY ===== -->
  <link name="base_link">
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.02"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.3 0.15 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.15 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- ===== FRONT LEFT LEG ===== -->
  
  <!-- Front Left Hip -->
  <link name="front_left_hip">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint: Base to Front Left Hip (Hip Rotation) -->
  <joint name="front_left_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_hip"/>
    <origin xyz="0.1 0.1 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
  </joint>

  <!-- Front Left Upper Leg -->
  <link name="front_left_upper_leg">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0008"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.04 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint: Hip to Upper Leg (Knee Rotation) -->
  <joint name="front_left_knee_joint" type="revolute">
    <parent link="front_left_hip"/>
    <child link="front_left_upper_leg"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
  </joint>

  <!-- Front Left Lower Leg -->
  <link name="front_left_lower_leg">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0008" iyz="0.0" izz="0.0007"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.03 0.12"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.12"/>
      </geometry>
    </collision>
  </link>

  <!-- Joint: Upper Leg to Lower Leg (Ankle) -->
  <joint name="front_left_ankle_joint" type="revolute">
    <parent link="front_left_upper_leg"/>
    <child link="front_left_lower_leg"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
  </joint>

  <!-- ===== FRONT RIGHT LEG ===== -->
  
  <link name="front_right_hip">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_hip"/>
    <origin xyz="0.1 -0.1 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
  </joint>

  <link name="front_right_upper_leg">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0008"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.04 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_knee_joint" type="revolute">
    <parent link="front_right_hip"/>
    <child link="front_right_upper_leg"/>
    <origin xyz="0 0 -0.07" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
  </joint>

  <link name="front_right_lower_leg">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0008" iyz="0.0" izz="0.0007"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.03 0.03 0.12"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.03 0.03 0.12"/>
      </geometry>
    </collision>
  </link>

  <joint name="front_right_ankle_joint" type="revolute">
    <parent link="front_right_upper_leg"/>
    <child link="front_right_lower_leg"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
  </joint>

  <!-- ===== REAR LEFT LEG ===== -->
  
  <link name="rear_left_hip">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>

  <joint name="rear_left_hip_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_left_hip"/>
    <origin xyz="-0.1 0.1 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="5"/>
  </joint>

  <link name="rear_left_upper_leg">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0008"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.04 0.04 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.04 0.1"/>
